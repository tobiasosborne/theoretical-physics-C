      "$description": "ladder rung 3 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.794, 0.09, 225] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "stage-q4": {
      "$type": "color",
      "$value": "{color.q4}",
      "$description": "ladder rung 4 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.691, 0.115, 238] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "stage-q5": {
      "$type": "color",
      "$value": "{color.q5}",
      "$description": "ladder rung 5 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.588, 0.125, 250] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "stage-q6": {
      "$type": "color",
      "$value": "{color.q6}",
      "$description": "ladder rung 6 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.485, 0.125, 262] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "grey-1": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.93, 0.004, 90] },
      "$description": "neutral grey 1 on the plate (1 lightest)"
    },
    "grey-2": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.84, 0.004, 90] },
      "$description": "neutral grey 2 on the plate (1 lightest)"
    },
    "grey-3": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.7, 0.004, 90] },
      "$description": "neutral grey 3 on the plate (1 lightest)"
    },
    "grey-4": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.55, 0.004, 90] },
      "$description": "neutral grey 4 on the plate (1 lightest)"
    },
    "grey-5": {
      "$type": "color",
      "$value": { "colorSpace": "oklch", "components": [0.4, 0.004, 90] },
      "$description": "neutral grey 5 on the plate (1 lightest)"
    }
  },
  "space": {
    "$description": "spacing steps as multiples of the body leading",
    "xs": {
      "$type": "number",
      "$value": 0.25
    },
    "s": {
      "$type": "number",
      "$value": 0.5
    },
    "m": {
      "$type": "number",
      "$value": 1
    },
    "l": {
      "$type": "number",
      "$value": 1.5
    },
    "xl": {
      "$type": "number",
      "$value": 2
    },
    "xxl": {
      "$type": "number",
      "$value": 3
    }
  },
  "stroke": {
    "$description": "line widths (pt) and dash patterns (pt on, pt off): the redundant coding of the physics roles",
    "hair": {
      "$type": "dimension",
      "$value": { "value": 0.3, "unit": "pt" }
    },
    "thin": {
      "$type": "dimension",
      "$value": { "value": 0.5, "unit": "pt" }
    },
    "regular": {
      "$type": "dimension",
      "$value": { "value": 0.8, "unit": "pt" }
    },
    "state": {
      "$type": "dimension",
      "$value": { "value": 1.2, "unit": "pt" }
    },
    "effect": {
      "$type": "dimension",
      "$value": { "value": 1.2, "unit": "pt" }
    },
    "dynamics": {
      "$type": "dimension",
      "$value": { "value": 1.7, "unit": "pt" }
    },
    "bath": {
      "$type": "dimension",
      "$value": { "value": 0.5, "unit": "pt" }
    },
    "dash-effect": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          { "value": 4.5, "unit": "pt" },
          { "value": 1.8, "unit": "pt" }
        ],
        "lineCap": "butt"
      }
    },
    "dash-bath": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          { "value": 0.9, "unit": "pt" },
          { "value": 1.8, "unit": "pt" }
        ],
        "lineCap": "butt"
      }
    },
    "depth-v": {
      "$type": "dimension",
      "$value": { "value": 1.5, "unit": "pt" }
    },
    "depth-f": {
      "$type": "dimension",
      "$value": { "value": 0.5, "unit": "pt" }
    },
    "box": {
      "$type": "dimension",
      "$value": { "value": 1.2, "unit": "pt" }
    }
  },
  "type": {
    "$description": "type-scale roles; packages override whole roles. depth-label is the run-in label of Vertiefung and Fundament: always body size (checked); a package varies only its face, weight and case",
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": { "value": 11, "unit": "pt" },
        "lineHeight": 1.2364,
        "fontWeight": 400,
        "fontStyle": "normal"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.serif}",
        "fontSize": { "value": 10, "unit": "pt" },
        "lineHeight": 1.2,
        "fontWeight": 400,
        "fontStyle": "normal"
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 8, "unit": "pt" },
        "lineHeight": 1.3125,
        "fontWeight": 400,
        "fontStyle": "normal"
      }
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 19, "unit": "pt" },
        "lineHeight": 1.2105,
        "fontWeight": 600,
        "fontStyle": "normal"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 12, "unit": "pt" },
        "lineHeight": 1.25,
        "fontWeight": 600,
        "fontStyle": "normal"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 11, "unit": "pt" },
        "lineHeight": 1.2364,
        "fontWeight": 600,
        "fontStyle": "normal"
      }
    },
    "numeral": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 30, "unit": "pt" },
        "lineHeight": 1.0,
        "fontWeight": 600,
        "fontStyle": "normal"
      }
    },
    "mono": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.mono}",
        "fontSize": { "value": 9, "unit": "pt" },
        "lineHeight": 1.3333,
        "fontWeight": 400,
        "fontStyle": "normal"
      }
    },
    "depth-label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.sans}",
        "fontSize": { "value": 11, "unit": "pt" },
        "lineHeight": 1.2364,
        "fontWeight": 600,
        "fontStyle": "normal"
      }
    },
    "web-leading": {
      "$type": "number",
      "$value": 1.55,
      "$description": "line-height of running text on screen (body, small, depth-label); print uses each role's own lineHeight"
    },
    "web-body": {
      "$type": "dimension",
      "$value": { "value": 1.125, "unit": "rem" }
    }
  },
  "measure": {
    "$description": "page grid in mm (A4, 210 wide) and the web column",
    "text": {
      "$type": "dimension",
      "$value": { "value": 114, "unit": "mm" }
    },
    "inner": {
      "$type": "dimension",
      "$value": { "value": 22, "unit": "mm" }
    },
    "gap": {
      "$type": "dimension",
      "$value": { "value": 6, "unit": "mm" }
    },
    "margin": {
      "$type": "dimension",
      "$value": { "value": 46, "unit": "mm" }
    },
    "top": {
      "$type": "dimension",
      "$value": { "value": 20, "unit": "mm" }
    },
    "bottom": {
      "$type": "dimension",
      "$value": { "value": 22, "unit": "mm" }
    },
    "web-text": {
      "$type": "dimension",
      "$value": { "value": 39, "unit": "rem" }
    },
    "web-gap": {
      "$type": "dimension",
      "$value": { "value": 2.25, "unit": "rem" }
    },
    "web-margin": {
      "$type": "dimension",
      "$value": { "value": 14, "unit": "rem" }
    },
    "plate-pad": {
      "$type": "dimension",
      "$value": { "value": 6, "unit": "pt" }
    }
  },
  "video": {
    "$description": "frame geometry shared by every package; the palette comes from the stage roles",
    "width": {
      "$type": "number",
      "$value": 1920
    },
    "height": {
      "$type": "number",
      "$value": 1080
    },
    "fps": {
      "$type": "number",
      "$value": 30
    }
  }
}
