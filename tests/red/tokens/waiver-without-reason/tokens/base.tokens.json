        },
        "org.tpc.use": "fill"
      }
    },
    "stage-bath-edge": {
      "$type": "color",
      "$value": "{color.bath-edge}",
      "$description": "boundary and hatching of a bath region on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.66, 0.012, 240] }
        },
        "org.tpc.use": "stroke"
      }
    },
    "stage-q1": {
      "$type": "color",
      "$value": "{color.q1}",
      "$description": "ladder rung 1 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [1.0, 0.0, 205] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "stage-q2": {
      "$type": "color",
      "$value": "{color.q2}",
      "$description": "ladder rung 2 on the stage",
      "$extensions": {
        "org.tpc.modes": {
          "dark": { "colorSpace": "oklch", "components": [0.897, 0.055, 212] }
        },
        "org.tpc.use": "ladder"
      }
    },
    "stage-q3": {
