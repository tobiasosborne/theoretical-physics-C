 "font": {
  "serif": {
   "$type": "fontFamily",
   "$value": [
    "STIX Two Text",
    "STIX Two Math",
    "serif"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "STIXTwoText",
      "options": "Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-Bold,BoldItalicFont=*-BoldItalic,Scale=0.955",
      "probe": "[STIXTwoText-Regular.otf]"
     },
     "local": {
      "font": "Times LT Std",
      "options": "Ligatures=TeX,BoldFont={Times LT Std Bold},ItalicFont={Times LT Std Italic},BoldItalicFont={Times LT Std Bold Italic}",
      "probe": "Times LT Std",
      "licence": "commercial (Linotype); local print only"
     }
    }
   },
   "$description": "open face scaled 0.955 so that STIX Two matches the x-height of Times at the same nominal size"
  },
  "sans": {
   "$type": "fontFamily",
   "$value": [
    "Inter",
    "system-ui",
    "sans-serif"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "Inter",
      "options": "Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-SemiBold,BoldItalicFont=*-SemiBoldItalic,Scale=MatchLowercase,Numbers=Tabular",
      "probe": "[Inter-Regular.otf]"
     },
     "local": {
      "font": "Whitney-Book.otf",
      "options": "BoldFont=Whitney-Semibold.otf,ItalicFont=Whitney-BookItalic.otf,BoldItalicFont=Whitney-SemiboldItalic.otf,Scale=MatchLowercase",
      "probe": "[Whitney-Book.otf]",
      "licence": "commercial (Hoefler&Co); local print only; lacks U+2192, take arrows from the math font"
     }
    }
   }
  },
  "mono": {
   "$type": "fontFamily",
   "$value": [
    "Iosevka",
    "ui-monospace",
    "monospace"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "Iosevka",
      "options": "Scale=MatchLowercase",
      "probe": "Iosevka"
     }
    }
   }
  },
  "math": {
   "$type": "fontFamily",
   "$value": [
    "STIX Two Math",
    "math"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "STIXTwoMath-Regular.otf",
      "options": "Scale=0.955",
      "probe": "[STIXTwoMath-Regular.otf]"
     },
     "local": {
      "engine": "mtpro2",
      "probe": "mtpro2.sty",
      "licence": "commercial (PCTeX MathTime Pro 2, Type 1); local print only; PDF maths not extractable"
     }
    }
   }
  }
 },
