 "font": {
  "serif": {
   "$type": "fontFamily",
   "$value": [
    "Libertinus Serif",
    "serif"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "LibertinusSerif",
      "options": "Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-Semibold,BoldItalicFont=*-SemiboldItalic,Numbers=OldStyle",
      "probe": "[LibertinusSerif-Regular.otf]"
     },
     "local": {
      "font": "Baskerville 10 Pro",
      "options": "Ligatures=TeX,Numbers=OldStyle",
      "probe": "Baskerville 10 Pro",
      "licence": "commercial (Storm Type Foundry); local print only"
     }
    }
   }
  },
  "sans": {
   "$type": "fontFamily",
   "$value": [
    "Inter",
    "system-ui",
    "sans-serif"
   ],
   "$extensions": {
    "org.tpc.tex": {
     "open": {
      "font": "Inter",
      "options": "Extension=.otf,UprightFont=*-Regular,ItalicFont=*-Italic,BoldFont=*-SemiBold,BoldItalicFont=*-SemiBoldItalic,Scale=MatchLowercase,Numbers=Tabular",
      "probe": "[Inter-Regular.otf]"
     },
     "local": {
      "font": "Whitney-Book.otf",
      "options": "BoldFont=Whitney-Semibold.otf,ItalicFont=Whitney-BookItalic.otf,BoldItalicFont=Whitney-SemiboldItalic.otf,Scale=MatchLowercase",
      "probe": "[Whitney-Book.otf]",
      "licence": "commercial (Hoefler&Co); local print only; lacks U+2192, take arrows from the math font"
     }
    }
   }
  },
  "mono": {
   "$type": "fontFamily",
   "$value": [
    "Iosevka",
    "ui-monospace",
    "monospace"
