   "l": 0,
   "tex": "\\Rnl{2}{0}(\\rad) &= \\frac{1}{2\\sqrt{2}}\\left(\\frac{\\Znuc}{\\aRed}\\right)^{3/2}\\left(2 - \\frac{\\Znuc\\rad}{\\aRed}\\right) e^{-\\Znuc\\rad/(2\\aRed)},",
   "expr": "(Z/a)**(3/2)*(2 - Z*r/a)*exp(-Z*r/(2*a))/(2*sqrt(2))"
