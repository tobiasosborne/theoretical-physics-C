{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "evidence/provenance.json",
 "type": "object",
 "required": [
  "schema_version",
  "provenance"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    1
   ]
  },
  "note": {
   "type": "string"
  },
  "provenance": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/provenance"
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "provenance": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "claim_ids",
    "source_key",
    "member",
    "member_sha256",
    "locus",
    "quote",
    "read_from",
    "reviewer",
    "review_receipt"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^P-[0-9]{4}$"
    },
    "claim_ids": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^c[0-9]{2}\\.cl\\.[a-z0-9]+(-[a-z0-9]+)*$"
     }
    },
    "source_key": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "member": {
     "type": "string",
     "minLength": 1
    },
    "member_sha256": {
     "type": "string",
     "pattern": "^[0-9a-f]{64}$"
    },
    "locus": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "line_start": {
       "type": "integer",
       "minimum": 1
      },
      "line_end": {
       "type": "integer",
       "minimum": 1
      },
      "page_index": {
       "type": "integer",
       "minimum": 1
      },
      "page_index_end": {
       "type": "integer",
       "minimum": 1
      },
      "printed_page": {
       "type": "string",
       "minLength": 1
      },
      "anchor": {
       "type": "string"
      }
     }
    },
    "quote": {
     "type": "string",
     "minLength": 10
    },
    "read_from": {
     "enum": [
      "text",
      "page-image"
     ]
    },
    "reviewer": {
     "type": [
      "string",
      "null"
     ]
    },
    "review_receipt": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^R-[0-9]{4}$"
    },
    "supports": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    }
   }
  }
 }
}
