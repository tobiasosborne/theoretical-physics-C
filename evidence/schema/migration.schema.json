{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "evidence/migrations/M-NNNN.json",
 "$ref": "#/$defs/migration",
 "$defs": {
  "migration": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_version",
    "id",
    "status",
    "title",
    "legacy",
    "reason",
    "evidence",
    "destination"
   ],
   "properties": {
    "schema_version": {
     "enum": [
      1
     ]
    },
    "id": {
     "type": "string",
     "pattern": "^M-[0-9]{4}$"
    },
    "status": {
     "enum": [
      "recorded",
      "applied"
     ]
    },
    "title": {
     "type": "string",
     "minLength": 5
    },
    "legacy": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "version",
       "file",
       "line",
       "file_sha256",
       "old_text",
       "new_text"
      ],
      "properties": {
       "version": {
        "enum": [
         "v0.1",
         "v0.2-de",
         "v0.2-en"
        ]
       },
       "file": {
        "type": "string",
        "minLength": 1
       },
       "line": {
        "type": "integer",
        "minimum": 1
       },
       "file_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "old_text": {
        "type": "string",
        "minLength": 3
       },
       "new_text": {
        "type": [
         "string",
         "null"
        ]
       },
       "gap_tjo": {
        "type": "string"
       },
       "applied_file_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "applied_source_key": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9.-]*$"
       }
      },
      "dependentRequired": {
       "applied_file_sha256": [
        "applied_source_key"
       ],
       "applied_source_key": [
        "applied_file_sha256"
       ]
      }
     }
    },
    "reason": {
     "type": "string",
     "minLength": 10
    },
    "evidence": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "independent_check",
      "provenance_ids"
     ],
     "properties": {
      "independent_check": {
       "type": "string",
       "minLength": 5
      },
      "provenance_ids": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^P-[0-9]{4}$"
       }
      },
      "derivation": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      }
     }
    },
    "destination": {
     "type": "string",
     "pattern": "^c[0-9]{2}(\\.[a-z0-9.-]+)?$"
    },
    "notes": {
     "type": "string"
    },
    "applied_date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
   },
   "allOf": [
    {
     "if": {
      "properties": {
       "status": {
        "const": "applied"
       }
      }
     },
     "then": {
      "required": [
       "applied_date"
      ],
      "properties": {
       "legacy": {
        "contains": {
         "required": [
          "applied_file_sha256",
          "applied_source_key"
         ]
        }
       }
      }
     },
     "else": {
      "not": {
       "required": [
        "applied_date"
       ]
      }
     }
    }
   ]
  }
 }
}
