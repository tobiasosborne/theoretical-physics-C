{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "sources/<key>/source.json",
 "$ref": "#/$defs/source",
 "$defs": {
  "source": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "schema_version",
    "key",
    "kind",
    "storage",
    "title",
    "authors",
    "files",
    "rights_ref"
   ],
   "properties": {
    "schema_version": {
     "enum": [
      1
     ]
    },
    "key": {
     "type": "string",
     "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "kind": {
     "enum": [
      "book",
      "paper",
      "data",
      "script-snapshot",
      "author-stipulation"
     ]
    },
    "storage": {
     "enum": [
      "private",
      "tracked"
     ]
    },
    "title": {
     "type": "string",
     "minLength": 3
    },
    "authors": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 2
     }
    },
    "edition": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "language": {
     "type": "string"
    },
    "publisher": {
     "type": "string"
    },
    "year": {
     "type": "string"
    },
    "identifiers": {
     "type": "object"
    },
    "retrieval": {
     "type": "object"
    },
    "identity_check": {
     "type": "string"
    },
    "files": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "path",
       "role",
       "sha256"
      ],
      "properties": {
       "path": {
        "type": "string",
        "minLength": 1
       },
       "role": {
        "enum": [
         "scan",
         "ocr-text",
         "text",
         "binary"
        ]
       },
       "media_type": {
        "type": "string"
       },
       "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "pages": {
        "type": "integer",
        "minimum": 1
       },
       "notes": {
        "type": "string"
       }
      }
     }
    },
    "extraction": {
     "type": "string"
    },
    "page_index_convention": {
     "type": "string"
    },
    "authority_for": {
     "type": "string"
    },
    "limitations": {
     "type": "string"
    },
    "rights_ref": {
     "enum": [
      "rights.json"
     ]
    },
    "supersedes": {
     "type": [
      "string",
      "null"
     ]
    },
    "errata": {
     "type": "array"
    },
    "registry_aliases": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "notes": {
     "type": "string"
    }
   }
  }
 }
}
