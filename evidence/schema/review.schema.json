{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "evidence/receipts/reviews/R-NNNN.json",
 "$ref": "#/$defs/review",
 "$defs": {
  "review": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "reviewer",
    "date",
    "covers",
    "verdict",
    "bindings"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^R-[0-9]{4}$"
    },
    "reviewer": {
     "type": "string",
     "minLength": 2
    },
    "date": {
     "type": "string",
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "covers": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 3
     }
    },
    "verdict": {
     "enum": [
      "pass",
      "fail"
     ]
    },
    "method": {
     "type": "string"
    },
    "notes": {
     "type": "string"
    },
    "bindings": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "provenance_id",
       "member_sha256",
       "quote_sha256"
      ],
      "properties": {
       "provenance_id": {
        "type": "string",
        "pattern": "^P-[0-9]{4}$"
       },
       "member_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       },
       "quote_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
       }
      }
     }
    }
   }
  }
 }
}
