{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "evidence/gaps.json",
 "type": "object",
 "required": [
  "schema_version",
  "gaps"
 ],
 "properties": {
  "schema_version": {
   "enum": [
    1
   ]
  },
  "note": {
   "type": "string"
  },
  "gaps": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/gap"
   }
  }
 },
 "additionalProperties": false,
 "$defs": {
  "gap": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id",
    "what",
    "needed_source",
    "where",
    "raised_in",
    "status"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^G-[0-9]{4}$"
    },
    "what": {
     "type": "string",
     "minLength": 10
    },
    "needed_source": {
     "type": "string",
     "minLength": 3
    },
    "where": {
     "type": "string",
     "minLength": 2
    },
    "raised_in": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "string",
      "minLength": 3
     }
    },
    "owner": {
     "type": "string"
    },
    "status": {
     "enum": [
      "open",
      "closed"
     ]
    },
    "notes": {
     "type": "string"
    }
   }
  }
 }
}
