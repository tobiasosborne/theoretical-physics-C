\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tpc-style}[2026/09/07 Theoretische Physik C lecture notes style]

% ══════════════════════════════════════════════════════════════
%  OPTIONS
% ══════════════════════════════════════════════════════════════
%   [german]   Babel German, German theorem headers      (default)
%   [english]  Babel English, English theorem headers
%   [cmfonts]  Computer Modern instead of Times LT Std / Whitney / mtpro2
%
% The two language builds share this file verbatim; only the option
% differs.  Every theorem environment exists under BOTH its German and
% its English name, so `\begin{beispiel}` and `\begin{example}` are the
% same environment and typeset the header word of the selected language.
% That is what lets scripts/check_parity.py compare the two sources
% structurally.

\newif\iftpc@cmfonts  \tpc@cmfontsfalse
\newif\iftpc@english  \tpc@englishfalse

\DeclareOption{cmfonts}{\tpc@cmfontstrue}
\DeclareOption{english}{\tpc@englishtrue}
\DeclareOption{german}{\tpc@englishfalse}
\ProcessOptions\relax

% ══════════════════════════════════════════════════════════════
%  LANGUAGE
% ══════════════════════════════════════════════════════════════
\iftpc@english
  \RequirePackage[english]{babel}
\else
  \RequirePackage[german]{babel}
\fi

% ══════════════════════════════════════════════════════════════
%  GEOMETRY
% ══════════════════════════════════════════════════════════════
\RequirePackage{geometry}
\geometry{a4paper, margin=2.5cm}

% ══════════════════════════════════════════════════════════════
%  COLOUR PALETTE
% ══════════════════════════════════════════════════════════════
% The original Theoretische Physik C palette, kept so the notes stay
% visually continuous with the versions students already have.
\RequirePackage{color}
\RequirePackage[table]{xcolor}

\definecolor{spacecadet}{HTML}{0D284C}   % deep navy — body emphasis
\definecolor{munsell}{HTML}{008FA8}      % teal — links
\definecolor{banana}{HTML}{FFD932}       % yellow — key equations
\definecolor{cgblue}{HTML}{007CA5}       % blue — headings, theorem names
\definecolor{isabelline}{HTML}{EAEDEA}   % near-white — box fills
\definecolor{light-gray}{gray}{0.85}

% Signal colours for figures (Birren industrial safety, cf. the GR notes)
\definecolor{birrenred}{HTML}{C4392F}
\definecolor{birrenorange}{HTML}{D97A2B}
\definecolor{birrengreen}{HTML}{3D7A55}
\definecolor{birrengray}{HTML}{8C8C84}

% ══════════════════════════════════════════════════════════════
%  GRAPHICS AND BOXES
% ══════════════════════════════════════════════════════════════
% tcolorbox is loaded before mathspec: loading it afterwards breaks the
% maths font setup.
\RequirePackage{graphicx}
\RequirePackage{wrapfig}
\RequirePackage[many]{tcolorbox}
\RequirePackage[textsize=tiny]{todonotes}

% ══════════════════════════════════════════════════════════════
%  MATHS FONTS
% ══════════════════════════════════════════════════════════════
% Load order matters: amsmath → mathtools → mtpro2 → mathspec.
\iftpc@cmfonts
  \RequirePackage{amsmath}
  \RequirePackage{amsthm}
  \RequirePackage{mathtools}
  \RequirePackage{fontspec}
  \RequirePackage{amssymb}
  \RequirePackage{mathrsfs}
\else
  \RequirePackage{amsmath}
  \RequirePackage{amsthm}
  \RequirePackage{mathtools}
  \RequirePackage[mtphrb,mtpcal,mtpfrak]{mtpro2}
  \RequirePackage{mathspec}
  \RequirePackage{mathrsfs}
  \setmathrm{Times LT Std}
  \setmainfont[
    BoldFont       = Times LT Std Bold,
    ItalicFont     = Times LT Std Italic,
    BoldItalicFont = Times LT Std Bold Italic,
    Ligatures      = TeX
  ]{Times LT Std}
  \setsansfont[
    BoldFont   = Whitney-Semibold.otf,
    ItalicFont = Whitney-MediumItalic.otf,
    Ligatures  = TeX
  ]{Whitney-Medium.otf}
  \setboldmathrm[BoldFont={Times LT Std Bold}]{Times LT Std Bold}
\fi

% ══════════════════════════════════════════════════════════════
%  TikZ & pgfplots
% ══════════════════════════════════════════════════════════════
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,decorations.markings,decorations.pathmorphing,
  patterns,positioning,shapes.geometric,backgrounds,matrix,fit,intersections}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{patchplots,fillbetween}

% ══════════════════════════════════════════════════════════════
%  LISTS, TABLES, BIBLIOGRAPHY, LINKS
% ══════════════════════════════════════════════════════════════
\RequirePackage{enumerate}
\RequirePackage{booktabs}
\RequirePackage[shortalphabetic]{amsrefs}
\RequirePackage[colorlinks=true,linkcolor=munsell,citecolor=munsell,
                urlcolor=munsell]{hyperref}

% ══════════════════════════════════════════════════════════════
%  SECTION FORMATTING
% ══════════════════════════════════════════════════════════════
% (@ is a letter throughout a .sty file — no \makeatletter pair needed)
\def\@secnumfont{\bfseries}
\def\part{\@startsection{part}{0}%
  \z@{\linespacing\@plus\linespacing}{.5\linespacing}%
  {\normalfont\bfseries\raggedright}}
\def\specialsection{\@startsection{section}{1}%
  \z@{\linespacing\@plus\linespacing}{.5\linespacing}%
  {\color{cgblue}\normalfont\centering}}
\def\section{\@startsection{section}{1}%
  \z@{.7\linespacing\@plus\linespacing}{.5\linespacing}%
  {\color{cgblue}\normalfont\sf\bfseries\large\centering}}
\def\subsection{\@startsection{subsection}{2}%
  \z@{.5\linespacing\@plus.7\linespacing}{-.5em}%
  {\color{cgblue}\normalfont\sf\bfseries}}
\def\subsubsection{\@startsection{subsubsection}{3}%
  \z@{.5\linespacing\@plus.7\linespacing}{-.5em}%
  {\color{cgblue}\normalfont\sf\itshape}}
\def\paragraph{\@startsection{paragraph}{4}%
  \z@\z@{-\fontdimen2\font}%
  \color{cgblue}\sf\normalfont}
\def\subparagraph{\@startsection{subparagraph}{5}%
  \z@\z@{-\fontdimen2\font}%
  \color{cgblue}\sf\normalfont}
% Title in sans, in the heading colour
\def\@settitle{\begin{center}%
  \baselineskip14\p@\relax
  \bfseries\sffamily\color{cgblue}%
  \uppercasenonmath\@title
  \@title
  \end{center}%
}

% ══════════════════════════════════════════════════════════════
%  THEOREM ENVIRONMENTS
% ══════════════════════════════════════════════════════════════
% Header words follow the selected language.
\iftpc@english
  \def\tpc@thm{Theorem}      \def\tpc@lem{Lemma}
  \def\tpc@prop{Proposition} \def\tpc@cor{Corollary}
  \def\tpc@defn{Definition}  \def\tpc@ex{Example}
  \def\tpc@exc{Exercise}     \def\tpc@sol{Solution}
  \def\tpc@rem{Remark}       \def\tpc@note{Note}
  \def\tpc@notation{Notation}\def\tpc@intu{Physical intuition}
  \def\tpc@conj{Conjecture}  \def\tpc@proto{Prototype definition}
\else
  \def\tpc@thm{Theorem}      \def\tpc@lem{Lemma}
  \def\tpc@prop{Proposition} \def\tpc@cor{Korollar}
  \def\tpc@defn{Definition}  \def\tpc@ex{Beispiel}
  \def\tpc@exc{\"Ubung}      \def\tpc@sol{L\"osung}
  \def\tpc@rem{Bemerkung}    \def\tpc@note{Notiz}
  \def\tpc@notation{Notation}\def\tpc@intu{Physikalische Anschauung}
  \def\tpc@conj{Vermutung}   \def\tpc@proto{Prototyp-Definition}
\fi

\theoremstyle{plain}
\newtheorem{theorem}{\tpc@thm}[section]
\newtheorem{lemma}[theorem]{\tpc@lem}
\newtheorem{proposition}[theorem]{\tpc@prop}
\newtheorem*{corollary}{\tpc@cor}

\theoremstyle{definition}
\newtheorem{definition}{\color{cgblue}\tpc@defn}[section]
\newtheorem{example}{\color{cgblue}\tpc@ex}[section]
\newtheorem{exercise}{\color{cgblue}\tpc@exc}[section]
\newtheorem{prototypedefinition}{\tpc@proto}[section]
\newtheorem{physicalintuition}{\tpc@intu}[section]
\newtheorem{conjecture}{\tpc@conj}[section]

\theoremstyle{remark}
\newtheorem*{remark}{\tpc@rem}
\newtheorem*{note}{\tpc@note}
\newtheorem*{notation}{\tpc@notation}

\newenvironment{solution}
  {\begin{proof}[\color{cgblue}\tpc@sol]\color{spacecadet}}
  {\end{proof}}

% German aliases.  These share the counter of their English counterpart,
% so `beispiel` and `example` number in one sequence and a lecture may be
% written in either language without renumbering.  The umlaut spellings
% are the ones the v0.1 sources use; XeLaTeX takes them verbatim.
\newtheorem{beispiel}[example]{\color{cgblue}\tpc@ex}
\newtheorem{übung}[exercise]{\color{cgblue}\tpc@exc}
\newtheorem{uebung}[exercise]{\color{cgblue}\tpc@exc}
\newenvironment{lösung}{\solution}{\endsolution}
\newenvironment{loesung}{\solution}{\endsolution}

% ══════════════════════════════════════════════════════════════
%  HIGHLIGHT BOXES
% ══════════════════════════════════════════════════════════════
% Key equation — yellow highlight behind the maths.
\def\eqbox#1{\tcboxmath[colback=banana,arc=0cm,frame hidden,enhanced]{#1}}

% Statement box — the full-width yellow callout the script uses for the
% one-sentence takeaways ("Materie und Strahlung besitzen ...").
\newtcolorbox{merksatz}[1][]{%
  enhanced, breakable,
  colback=banana, frame hidden, arc=0cm,
  left=10pt, right=10pt, top=8pt, bottom=8pt,
  detach title, before upper={\ifx\relax#1\relax\else
    \textbf{\textsf{\color{spacecadet}#1}}\par\smallskip\fi}}

% Neutral grey box — asides, intuition, historical notes.
\newtcolorbox{greybox}[1][]{%
  enhanced, breakable,
  colback=isabelline, frame hidden, arc=3pt,
  left=8pt, right=8pt, top=8pt, bottom=6pt,
  detach title, before upper={\ifx\relax#1\relax\else
    \textbf{\textsf{\color{spacecadet}#1}}\par\smallskip\fi}}

\newtcolorbox{intuition}[1][]{%
  enhanced, breakable,
  colback=isabelline, frame hidden, arc=3pt,
  left=8pt, right=8pt, top=8pt, bottom=6pt,
  detach title, before upper={\textbf{\textsf{\color{spacecadet}%
    \ifx\relax#1\relax\tpc@intu\else#1\fi}}\par\smallskip}}

\newtcolorbox{historical}[1][]{%
  enhanced, breakable,
  colback=isabelline, frame hidden, arc=3pt,
  left=8pt, right=8pt, top=8pt, bottom=6pt,
  detach title, before upper={\textbf{\textsf{\color{spacecadet}%
    \ifx\relax#1\relax\iftpc@english Historical note\else
    Historische Notiz\fi\else#1\fi}}\par\smallskip}}

% Figure placeholder — a blank frame standing in for a blackboard sketch
% that has not been drawn yet.
\def\figbox{\begin{center}%
  \tcboxmath[colback=isabelline,frame hidden,enhanced,sharp corners]%
    {\parbox[c][3cm][c]{10cm}{\ }}\end{center}}

\newcommand{\red}[1]{\textcolor{birrenred}{#1}}

\endinput
