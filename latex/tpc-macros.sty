\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tpc-macros}[2026/09/07 Theoretische Physik C macro library]

% Notation follows the existing script: operators are \widehat, the Hilbert
% space is \mathcal{H}, Dirac brackets are spelled out with \langle/\rangle.
% Every macro below is additive — nothing here changes how the v0.1 sources
% typeset, so the German and English builds stay comparable.

% ══════════════════════════════════════════════════════════════
%  OPERATORS DECLARED BY THE SCRIPT
% ══════════════════════════════════════════════════════════════
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\supp}{supp}
\DeclareMathOperator{\id}{id}
\DeclareMathOperator{\vspan}{span}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\sgn}{sgn}
\DeclareMathOperator{\real}{Re}
\DeclareMathOperator{\imag}{Im}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\conf}{conf}
\DeclareMathOperator{\res}{res}
\DeclareMathOperator{\im}{im}
\DeclareMathOperator{\aut}{Aut}
\DeclareMathOperator*{\argmax}{arg\,max}
\DeclareMathOperator*{\argmin}{arg\,min}

% ══════════════════════════════════════════════════════════════
%  NUMBER SYSTEMS AND SPACES
% ══════════════════════════════════════════════════════════════
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\N}{\mathbb{N}}
\newcommand{\Rn}[1]{\mathbb{R}^{#1}}
\newcommand{\Cn}[1]{\mathbb{C}^{#1}}
\newcommand{\Ex}{\mathbb{E}}              % expectation
\newcommand{\Hil}{\mathcal{H}}            % Hilbert space
\newcommand{\Lop}{\mathcal{L}}            % bounded operators / Liouvillian
\newcommand{\Zst}{\mathcal{Z}}            % partition function

% ══════════════════════════════════════════════════════════════
%  DIRAC NOTATION
% ══════════════════════════════════════════════════════════════
% \ket{\psi}  \bra{\psi}  \braket{\phi}{\psi}  \ketbra{\phi}{\psi}
% \expval{\widehat{A}}    expectation value  <A>
% \melem{\phi}{\widehat{A}}{\psi}   matrix element  <phi|A|psi>
\newcommand{\ket}[1]{\lvert #1 \rangle}
\newcommand{\bra}[1]{\langle #1 \rvert}
\newcommand{\braket}[2]{\langle #1 \mid #2 \rangle}
\newcommand{\ketbra}[2]{\lvert #1 \rangle\!\langle #2 \rvert}
\newcommand{\expval}[1]{\langle #1 \rangle}
\newcommand{\melem}[3]{\langle #1 \rvert #2 \lvert #3 \rangle}

% Adjoint / Hermitian conjugate
\newcommand{\adj}{^{\dagger}}
\newcommand{\herm}[1]{#1^{\dagger}}

% Commutator and anticommutator
\newcommand{\comm}[2]{\left[ #1, #2 \right]}
\newcommand{\acomm}[2]{\left\{ #1, #2 \right\}}

% ══════════════════════════════════════════════════════════════
%  OPERATORS OF THE COURSE
% ══════════════════════════════════════════════════════════════
% The script writes operators as \widehat{x}; \op is the shorthand.
\newcommand{\op}[1]{\widehat{#1}}
\newcommand{\xop}{\widehat{x}}
\newcommand{\pop}{\widehat{p}}
\newcommand{\Hop}{\widehat{H}}
\newcommand{\rhoop}{\widehat{\rho}}
\newcommand{\Lz}{\widehat{L}_z}
\newcommand{\Lsq}{\widehat{L}^2}
\newcommand{\aop}{\widehat{a}}
\newcommand{\adop}{\widehat{a}^{\dagger}}
\newcommand{\numop}{\widehat{n}}

% ══════════════════════════════════════════════════════════════
%  DERIVATIVES
% ══════════════════════════════════════════════════════════════
\newcommand{\pd}[3][]{\frac{\partial^{#1} #2}{\partial {#3}^{#1}}}
\newcommand{\td}[2]{\frac{d #1}{d #2}}
\newcommand{\dd}{\mathrm{d}}
\newcommand{\lap}{\Delta}
\newcommand{\grad}{\nabla}

% ══════════════════════════════════════════════════════════════
%  DELIMITERS
% ══════════════════════════════════════════════════════════════
\newcommand{\abs}[1]{\left\lvert #1 \right\rvert}
\newcommand{\norm}[1]{\left\lVert #1 \right\rVert}
\newcommand{\set}[1]{\left\{ #1 \right\}}
\newcommand{\vb}[1]{\boldsymbol{#1}}
\newcommand{\uv}[1]{\hat{\boldsymbol{#1}}}

% ══════════════════════════════════════════════════════════════
%  STATISTICAL PHYSICS
% ══════════════════════════════════════════════════════════════
\newcommand{\kB}{k_{\mathrm{B}}}
\newcommand{\Zc}{\mathcal{Z}}             % canonical partition function
\newcommand{\Om}{\Omega}                  % microcanonical state count
\newcommand{\betainv}{\frac{1}{\kB T}}

% ══════════════════════════════════════════════════════════════
%  TikZ STYLES
% ══════════════════════════════════════════════════════════════
% Shared by every figure so the plates read as one set.  Colours come
% from tpc-style.sty.
\tikzset{
  % arrows
  vecstyle/.style   ={-{Stealth[length=6pt,width=4pt]}, thick, cgblue},
  axisstyle/.style  ={-{Stealth[length=6pt,width=4pt]}, thick, spacecadet},
  maparrow/.style   ={-{Stealth[length=6pt]}, thick, munsell},
  % curves
  wavefn/.style     ={line width=1.1pt, cgblue},
  wavefn alt/.style ={line width=1.1pt, birrenred},
  envelope/.style   ={line width=0.8pt, birrengray, dashed},
  potential/.style  ={line width=1.2pt, spacecadet},
  levelline/.style  ={line width=0.7pt, birrenorange},
  % An energy level drawn as a reference rule rather than as data: use
  % this whenever colour is already carrying the quantum number.
  levellinegrey/.style={line width=0.6pt, birrengray!70, densely dashed},
  classicallim/.style={line width=0.8pt, birrengray, densely dotted},
  % regions and marks
  forbidden/.style  ={pattern=north east lines, pattern color=birrengray!50},
  fillregion/.style ={draw=none, fill=isabelline, rounded corners=2pt},
  statepoint/.style ={circle, fill=cgblue, inner sep=1.5pt},
  % labels
  lbl/.style        ={font=\footnotesize, text=spacecadet},
  lbl head/.style   ={font=\sf\small\bfseries, text=cgblue},
}

\endinput
