{
  "version": 2,
  "note": "Machine-readable half of docs/authoring/CONTRACT.md. scripts/course/check_levels.py and the HTML converter read the lists from here; change both files together.",
  "owns": "This file owns the TEXT-MODE language of content files: sectioning, environments, text macros, control symbols, the forbidden list, the ID grammar, the claim and source-reference syntax. It does not list the commands allowed inside mathematics: those are owned by registry/allowed-tex.json (and the notation registry) and enforced by scripts/registry/check_registry.py, which reads text_macros and math_text_switch from here and refuses a word that both files claim. The one rule of this file that also binds mathematics is forbidden_everywhere.",
  "id_grammar": {
    "chapter": "^c[0-9]{2}$",
    "section": "^c[0-9]{2}\\.s[1-9][0-9]*$",
    "subsection": "^c[0-9]{2}\\.s[1-9][0-9]*\\.[1-9][0-9]*$",
    "vertiefung": "^c[0-9]{2}\\.v[1-9][0-9]*$",
    "fundament": "^c[0-9]{2}\\.f[1-9][0-9]*$",
    "typed": "^c[0-9]{2}\\.(eq|thm|lem|prop|cor|ex|exc|fig|tab|demo|cl)\\.[a-z0-9]+(-[a-z0-9]+)*$",
    "definition": "^[DT][1-9][0-9]*$"
  },
  "sectioning": { "chapter": "chapter", "section": "section", "subsection": "subsection" },
  "numbered_units": {
    "theorem": "thm", "lemma": "lem", "proposition": "prop", "corollary": "cor",
    "example": "ex", "exercise": "exc"
  },
  "theorem_like": ["theorem", "lemma", "proposition", "corollary"],
  "unnumbered_units": ["remark", "proof", "solution"],
  "boxes": ["merksatz", "intuition", "historical", "greybox"],
  "lists": ["itemize", "enumerate", "description"],
  "depth_blocks": { "vertiefung": "v", "fundament": "f" },
  "depth_keys": ["id", "titel", "wozu", "voraussetzung", "zurueck"],
  "figure_envs": { "tpcfigure": "fig", "tpctable": "tab" },
  "table_envs": ["tabular"],
  "display_math": ["equation", "equation*", "align", "align*"],
  "inner_math": ["aligned", "split", "cases", "matrix", "pmatrix", "bmatrix", "vmatrix", "smallmatrix"],
  "text_macros": [
    "chapter", "section", "subsection",
    "label", "ref", "eqref", "pageref", "zoomref",
    "claim", "num", "demo", "caption", "tpcdef", "defref", "srcref",
    "emph", "textbf", "item", "tpcifenglish", "dots", "ldots",
    "toprule", "midrule", "bottomrule", "begin", "end"
  ],
  "control_symbols": ["\\\\", "\\ ", "\\,", "\\;", "\\:", "\\!", "\\%", "\\&", "\\$", "\\#", "\\_", "\\{", "\\}", "\\-", "\\|"],
  "math_text_switch": ["text"],
  "forbidden_everywhere": [
    "def", "gdef", "edef", "xdef", "let", "newcommand", "renewcommand", "providecommand",
    "DeclareMathOperator", "newenvironment", "newtheorem", "newcounter",
    "setcounter", "addtocounter", "stepcounter", "refstepcounter", "numberwithin",
    "input", "include", "usepackage", "RequirePackage", "documentclass",
    "vspace", "hspace", "vskip", "hskip", "kern", "smallskip", "medskip", "bigskip",
    "newpage", "clearpage", "pagebreak", "linebreak", "nopagebreak", "noindent", "par",
    "hfill", "vfill", "rule", "raisebox", "mbox", "hbox", "vbox", "parbox", "makebox", "fbox",
    "tag", "nonumber", "intertext", "shortintertext",
    "tikz", "draw", "node", "includegraphics", "pgfplotsset",
    "footnote", "marginpar", "marginnote", "todo",
    "color", "textcolor", "colorbox", "definecolor", "colorlet",
    "fontsize", "selectfont", "tiny", "scriptsize", "footnotesize", "small", "normalsize",
    "large", "Large", "LARGE", "huge", "Huge",
    "bfseries", "itshape", "sffamily", "ttfamily", "rmfamily", "textit", "textsf", "texttt", "textrm", "underline",
    "centering", "raggedright", "raggedleft",
    "makeatletter", "makeatother", "csname", "endcsname", "expandafter", "noexpand", "relax",
    "else", "fi", "or", "loop", "repeat",
    "cite", "bibitem", "index", "href", "url",
    "eqbox", "figbox", "red", "tpcdeclaredef", "tpcsetchapter"
  ],
  "forbidden_environments_named": [
    "definition", "tikzpicture", "axis", "figure", "table", "center", "minipage", "verbatim",
    "eqnarray", "displaymath", "math", "gather", "multline", "array", "tcolorbox",
    "beispiel", "uebung", "loesung", "note", "notation", "conjecture",
    "prototypedefinition", "physicalintuition"
  ],
  "evidence_statuses": ["source-quoted", "source-backed", "derived", "numerically-checked", "author-stipulated"],
  "presentations": ["proof-included", "proof-omitted", "proof-linked"],
  "depths": ["kern", "vertiefung", "fundament"],
  "claim_syntax": "\\claim[presentation]{id}{status}: id matches id_grammar.typed with kind cl; status is one of evidence_statuses; the optional presentation is one of presentations and is admitted only on the claim of a theorem_like unit",
  "num_syntax": "\\num[claim-id]{value}{unit}: text or mathematics; claim-id (id_grammar.typed, kind cl) is optional only inside a display or theorem_like unit that carries a supporting \\claim; unit may be empty; evidence that supports a number is number_evidence",
  "number_evidence": ["derived", "numerically-checked", "source-quoted", "source-backed"],
  "source_registry": "sources/<key>/source.json",
  "source_key": "^[a-z0-9][a-z0-9.-]*$",
  "zoom_scales": ["gpt", "single-system", "many-particle", "fock", "statistical-mechanics", "thermodynamics", "none"],
  "asset_kinds": ["figure", "table", "demo", "game", "video"],
  "test_chapters": ["c99"]
}
